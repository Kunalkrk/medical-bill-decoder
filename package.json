  "description": "Paste a hospital bill or EOB; get a plain-English explanation, possible-issue flags, a summary, and a draft message.",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env --watch server.js",
    "eval": "node --env-file=.env scripts/eval.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "cors": "^2.8.5",
